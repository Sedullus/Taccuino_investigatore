    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/archivo-narrow": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "idb-keyval": "^6.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.0.4",
    "vitest": "^3.2.4"
  }
